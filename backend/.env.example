# ==========================================
# ERP 后端环境变量配置模板
# 复制为 .env 后按需修改，.env 文件不会提交到 Git
# ==========================================

# 安全密钥（线上必须修改！）
SECRET_KEY=django-insecure-ebt7f8bdhh)rvm&pxd1%cr@ph@crf$c4f!s=4@)r-j6ugn=@!#

# 调试模式（线上必须设为 False）
DEBUG=True

# 允许访问的域名（线上必须限制）
# 本地开发用 *，线上用逗号分隔的域名列表
ALLOWED_HOSTS=*
# ALLOWED_HOSTS=5phone.xyz,www.5phone.xyz,8.162.15.218

# ==========================================
# 数据库配置
# ==========================================
# 设为 mysql 使用 MySQL，留空或 sqlite3 使用 SQLite
DB_ENGINE=sqlite3

# MySQL 连接参数（仅 DB_ENGINE=mysql 时生效）
DB_NAME=erp_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
